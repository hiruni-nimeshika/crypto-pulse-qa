
// Reads automation/results.json (written by Playwright) and produces:
//   docs/auto-test-results.md          a summary of the automated run
//   docs/bugs/DRAFT-<id>.md            one DRAFT bug report per failing check
// Drafts are NOT confirmed bugs. Reproduce each one by hand, then edit and rename it.
const fs = require('fs');
const path = require('path');

const resultsFile = path.join('automation', 'results.json');
if (!fs.existsSync(resultsFile)) {
  console.error('automation/results.json not found. Run "npm test" first.');
  process.exit(1);
}
const data = JSON.parse(fs.readFileSync(resultsFile, 'utf8'));
const strip = (s) => String(s || '').replace(/\u001b\[[0-9;]*m/g, '');

const rows = [];
(function walk(suites) {
  for (const s of suites || []) {
    for (const spec of s.specs || []) {
      for (const t of spec.tests || []) {
        const last = (t.results || [])[t.results.length - 1] || {};
        const err = (last.error && last.error.message) || (last.errors && last.errors[0] && last.errors[0].message) || '';
        rows.push({
          title: spec.title,
          project: t.projectName,
          status: t.status, // expected | unexpected | flaky | skipped
          error: strip(err).split('\n').slice(0, 12).join('\n'),
          attachments: (last.attachments || []).filter((a) => a.path).map((a) => a.path),
        });
      }
    }
    walk(s.suites);
  }
})(data.suites);

const label = (s) => ({ expected: 'Pass', unexpected: 'Fail', flaky: 'Flaky', skipped: 'Skipped' }[s] || s);
const projects = [...new Set(rows.map((r) => r.project))];
const titles = [...new Set(rows.map((r) => r.title))];
const now = new Date().toISOString().slice(0, 16).replace('T', ' ');

let md = `# Automated test results\n\nGenerated: ${now}\nTarget: ${(data.config && data.config.projects && data.config.projects[0] && data.config.projects[0].use && data.config.projects[0].use.baseURL) || process.env.BASE_URL || 'http://localhost:5173'}\n\n`;
md += `| Browser | Pass | Fail | Skipped |\n|---|---|---|---|\n`;
for (const p of projects) {
  const rs = rows.filter((r) => r.project === p);
  md += `| ${p} | ${rs.filter((r) => r.status === 'expected').length} | ${rs.filter((r) => r.status === 'unexpected').length} | ${rs.filter((r) => r.status === 'skipped').length} |\n`;
}
md += `\n## Results by check\n\n| Check | ${projects.join(' | ')} |\n|---|${projects.map(() => '---').join('|')}|\n`;
for (const t of titles) {
  md += `| ${t} | ${projects.map((p) => { const r = rows.find((x) => x.title === t && x.project === p); return r ? label(r.status) : '-'; }).join(' | ')} |\n`;
}

const failing = titles.filter((t) => rows.some((r) => r.title === t && r.status === 'unexpected'));
md += `\n## Failures to investigate (${failing.length})\n\n`;
if (!failing.length) md += 'No automated check failed. Continue with manual and exploratory testing.\n';

fs.mkdirSync(path.join('docs', 'bugs'), { recursive: true });
let n = 1;
for (const t of failing) {
  const fails = rows.filter((r) => r.title === t && r.status === 'unexpected');
  const id = String(n).padStart(3, '0');
  const browsers = fails.map((f) => f.project).join(', ');
  const evidence = [...new Set(fails.flatMap((f) => f.attachments))].filter((p) => /\.png$/.test(p));
  md += `- **${t}**: failed in ${browsers} (draft: docs/bugs/DRAFT-${id}.md)\n`;
  const draft = `# DRAFT-${id}: ${t.replace(/^TC-\w+\s*/, '')}

> **DRAFT, not a confirmed bug.** This was produced by an automated check. Reproduce it manually,
> confirm it is a real problem, then fill in the missing parts, rename the file to BUG-${id}.md,
> and open a GitHub Issue.

- **Linked check:** ${t}
- **Environment:** ${browsers}; target ${process.env.BASE_URL || 'http://localhost:5173'}
- **Severity:** (decide: Critical / High / Medium / Low)
- **Priority:** (decide)

## Steps to reproduce
(write the exact manual steps you used to reproduce it)

## Expected result
(what should happen)

## Actual result
(what you saw)

## Automated check output
\`\`\`
${fails[0].error || '(no error text captured)'}
\`\`\`

## Evidence
${evidence.length ? evidence.map((p) => `- ${p}`).join('\n') : '- (add a screenshot or screen recording)'}
`;
  fs.writeFileSync(path.join('docs', 'bugs', `DRAFT-${id}.md`), draft);
  n++;
}
fs.writeFileSync(path.join('docs', 'auto-test-results.md'), md);
console.log(`Wrote docs/auto-test-results.md and ${failing.length} draft bug file(s).`);
